# Get a key at https://console.getsolari.com
SOLARI_API_KEY=slr_live_...
OPENAI_API_KEY=sk-...
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4.1-mini

# Optional: target a different site for exploratory runs.
# The deterministic acceptance path uses the bundled demo store.
# TARGET_URL=https://example.com

# Optional guardrails.
# AGENTQA_MISSION=Test checkout as a first-time customer.
# AGENTQA_MAX_TURNS=12
# AGENTQA_MAX_ACTIONS=24

# Optional: on-chain report attestation via KeeperHub (`npm run attest`).
# Leave KEEPERHUB_API_KEY unset and AgentQA runs exactly as before - the
# attestation step is skipped, not failed.
# KEEPERHUB_API_KEY=kh_...
# KEEPERHUB_WALLET_ADDRESS=0x...          # the wallet integration's address; required when the key is set
# KEEPERHUB_ATTEST_RECIPIENT=0x...        # defaults to the wallet itself, i.e. a self-send
# KEEPERHUB_CHAIN_ID=11155111             # Sepolia
# KEEPERHUB_ATTEST_AMOUNT_ETH=0.001       # counts against the org's daily spend cap, testnet included
# KEEPERHUB_WORKFLOW_NAME=AgentQA Report Attestation (Sepolia)
# KEEPERHUB_BASE_URL=https://app.keeperhub.com
# KEEPERHUB_TIMEOUT_MS=180000
# KEEPERHUB_RPC_URL=https://...                 # read-only node used to re-read the tx and confirm the digest
